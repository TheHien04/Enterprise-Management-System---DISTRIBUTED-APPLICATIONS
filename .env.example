# ── General ──────────────────────────────────────────────
ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=udpt
POSTGRES_PASSWORD=udpt_secret

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── MinIO (Object Storage) ───────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=udpt_minio
MINIO_SECRET_KEY=udpt_minio_secret
MINIO_BUCKET=udpt-documents

# ── Service URLs (internal Docker network) ───────────────
GATEWAY_URL=http://api-gateway:8080
CONTRACT_SERVICE_URL=http://contract-service:8001
PRICING_SERVICE_URL=http://pricing-service:8002
OPERATION_SERVICE_URL=http://operation-service:8003
BILLING_SERVICE_URL=http://billing-service:8004
WORKFLOW_SERVICE_URL=http://workflow-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006
AUDIT_SERVICE_URL=http://audit-service:8007
ESIGN_SERVICE_URL=http://esign-service:8008

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
